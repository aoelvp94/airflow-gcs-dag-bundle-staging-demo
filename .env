# Anonymous credentials. fake-gcs-server does not check them. Nothing here is a real key.
AIRFLOW_CONN_GOOGLE_CLOUD_DEFAULT={"conn_type":"google_cloud_platform","extra":{"project":"demo-local","is_anonymous":true}}

# google-cloud-storage sends GCS calls here instead of storage.googleapis.com.
# The proxy counts them and forwards to the fake-gcs container.
STORAGE_EMULATOR_HOST=http://gcs-proxy:8888

# Two live bundles, same file set, two classes.
# refresh_interval is long so a steady-state processor does not walk the
# prefix again while the benchmark is counting requests.
#
# gcs-per-object: GCSDagBundle from the overlaid tip. prefix is the only
# source. This class has no archive_object argument and does not unlink a
# sibling .{name}/etag.
# gcs-archive: GCSArchiveDagBundle from the same module. archive_object is
# the only source. There is no prefix argument. The ETag marker is
# .archive_etag inside the staged tree.
#
# apache-airflow-providers-google 22.3.0 does not ship the archive class.
# The image overlays vendor/gcs.py (aoelvp94/airflow@acec0cf,
# apache/airflow#75566, same class split as #73015) onto
# airflow.providers.google.cloud.bundles.gcs, so both classpaths below are
# that file.
AIRFLOW__DAG_PROCESSOR__DAG_BUNDLE_CONFIG_LIST=[{"name":"gcs-per-object","classpath":"airflow.providers.google.cloud.bundles.gcs.GCSDagBundle","kwargs":{"bucket_name":"dag-bundles","prefix":"dags/","gcp_conn_id":"google_cloud_default","refresh_interval":86400}},{"name":"gcs-archive","classpath":"airflow.providers.google.cloud.bundles.gcs.GCSArchiveDagBundle","kwargs":{"bucket_name":"dag-bundles","archive_object":"archive/dag-bundle.tar.gz","gcp_conn_id":"google_cloud_default","refresh_interval":86400}}]
